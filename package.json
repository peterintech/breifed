{
  "name": "briefed",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "assets:copy": "cp node_modules/htmx.org/dist/htmx.min.js public/htmx.min.js",
    "css:dev": "tailwindcss -i ./views/css/styles.css -o ./public/styles.css --watch",
    "css:build": "tailwindcss -i ./views/css/styles.css -o ./public/styles.css --minify",
    "build": "cp node_modules/htmx.org/dist/htmx.min.js public/htmx.min.js && tailwindcss -i ./views/css/styles.css -o ./public/styles.css --minify"
  },
  "dependencies": {
    "htmx.org": "2.0.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
}
