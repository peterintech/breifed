package views

import (
	"github.com/google/uuid"
	"github.com/peterintech/briefed/components"
	webtypes "github.com/peterintech/briefed/types"
)

templ Home(data webtypes.HomeData) {
	@Page("Briefed · Your daily reading", data.Viewer) {
		<main>
			@components.TopicFilters(data.Timeline)
			@components.Timeline(data.Timeline)
		</main>
		if data.Viewer == nil {
			@components.OnboardingModal(webtypes.InterestStepData{Categories: data.Categories, Selected: map[uuid.UUID]bool{}})
		}
	}
}
