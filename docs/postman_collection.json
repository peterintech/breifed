{
  "info": {
    "_postman_id": "9f8d6b52-e6cb-4b18-a833-8a5e52931854",
    "name": "Briefed API",
    "description": "Postman collection for the Briefed public and personalized RSS/Atom aggregator. Public timeline requests work immediately; register or log in for personalization and Postman's cookie jar will retain the briefed_session cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "replace-with-category-uuid",
      "type": "string"
    },
    {
      "key": "category_ids",
      "value": "replace-with-comma-separated-category-uuids",
      "type": "string"
    },
    {
      "key": "feed_id",
      "value": "replace-with-feed-uuid",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Readiness check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "health"
              ]
            },
            "description": "Returns the service readiness response."
          },
          "response": []
        },
        {
          "name": "Intentional error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/err",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "err"
              ]
            },
            "description": "Development endpoint that intentionally returns an error."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\",\n  \"category_ids\": [],\n  \"feed_ids\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Creates a user, saves optional interests/follows, and starts a cookie session."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Starts a cookie session. Postman retains the briefed_session cookie automatically."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Deletes the current session and clears its cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Discovery",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "categories"
              ]
            },
            "description": "Lists all seeded categories alphabetically."
          },
          "response": []
        },
        {
          "name": "Discover feeds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/feeds?category_ids={{category_ids}}&q=&limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "feeds"
              ],
              "query": [
                {
                  "key": "category_ids",
                  "value": "{{category_ids}}",
                  "description": "Comma-separated category UUIDs",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Feed-name search",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Finds public feeds matching any supplied category UUID and optional text search."
          },
          "response": []
        },
        {
          "name": "Get feed by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/feeds/{{feed_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "feeds",
                "{{feed_id}}"
              ]
            },
            "description": "Returns one public feed with its categories."
          },
          "response": []
        },
        {
          "name": "Contribute feed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/feed.xml\",\n  \"category_ids\": [\n    \"{{category_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/feeds",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "feeds"
              ]
            },
            "description": "Validates and publishes an RSS/Atom feed, assigns categories, and follows it for the current user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Profile and follows",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me"
              ]
            },
            "description": "Returns the current user, selected categories, and followed feeds."
          },
          "response": []
        },
        {
          "name": "Replace interests",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_ids\": [\n    \"{{category_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/me/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me",
                "categories"
              ]
            },
            "description": "Replaces all selected categories for the current user."
          },
          "response": []
        },
        {
          "name": "Replace preferences atomically",
          "request": {
            "method": "PUT",
            "header": [{"key":"Content-Type","value":"application/json","type":"text"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_ids\": [\n    \"{{category_id}}\"\n  ],\n  \"feed_ids\": [\n    \"{{feed_id}}\"\n  ]\n}",
              "options": {"raw":{"language":"json"}}
            },
            "url": {
              "raw": "{{base_url}}/v1/me/preferences",
              "host": ["{{base_url}}"],
              "path": ["v1","me","preferences"]
            },
            "description": "Replaces interests and followed feeds in one transaction and returns the updated profile."
          },
          "response": []
        },
        {
          "name": "List followed feeds",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/me/feeds",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me",
                "feeds"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Follow feed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/me/feeds/{{feed_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me",
                "feeds",
                "{{feed_id}}"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Unfollow feed",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/me/feeds/{{feed_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "me",
                "feeds",
                "{{feed_id}}"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Public or personalized timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/posts?category_ids={{category_ids}}&q=&limit=20&offset=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "posts"
              ],
              "query": [
                {
                  "key": "category_ids",
                  "value": "{{category_ids}}",
                  "description": "Comma-separated category UUIDs; matches any.",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Searches title, description, and feed name.",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Returns an envelope with posts, mode, pagination, and has_more. Anonymous mode is global; a valid session yields personalized or global_fallback mode."
          },
          "response": []
        }
      ]
    }
  ]
}
