{
  "openapi": "3.0.3",
  "info": {"title": "Briefed API", "version": "1.0.0", "description": "Personalized RSS and Atom feed aggregator API."},
  "servers": [{"url": "http://localhost:8080"}],
  "tags": [{"name":"Authentication"},{"name":"Discovery"},{"name":"Profile"},{"name":"Posts"},{"name":"Health"}],
  "components": {
    "securitySchemes": {"sessionCookie": {"type":"apiKey","in":"cookie","name":"briefed_session","description":"HTTP-only cookie set by register/login."}},
    "schemas": {
      "Error": {"type":"object","required":["error"],"properties":{"error":{"type":"string"}}},
      "UUID": {"type":"string","format":"uuid"},
      "Category": {"type":"object","properties":{"id":{"$ref":"#/components/schemas/UUID"},"name":{"type":"string"},"slug":{"type":"string"},"created_at":{"type":"string","format":"date-time"}}},
      "User": {"type":"object","properties":{"id":{"$ref":"#/components/schemas/UUID"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"name":{"type":"string"},"email":{"type":"string","format":"email"}}},
      "Feed": {"type":"object","properties":{"id":{"$ref":"#/components/schemas/UUID"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"name":{"type":"string"},"url":{"type":"string","format":"uri"},"submitted_by":{"oneOf":[{"$ref":"#/components/schemas/UUID"},{"type":"null"}]},"last_fetched_at":{"oneOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"categories":{"type":"array","items":{"$ref":"#/components/schemas/Category"}}}},
      "Post": {"type":"object","properties":{"id":{"$ref":"#/components/schemas/UUID"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"title":{"type":"string"},"description":{"oneOf":[{"type":"string"},{"type":"null"}]},"published_at":{"type":"string","format":"date-time"},"url":{"type":"string","format":"uri"},"feed_id":{"$ref":"#/components/schemas/UUID"}}},
      "RegisterRequest": {"type":"object","required":["name","email","password"],"properties":{"name":{"type":"string"},"email":{"type":"string","format":"email"},"password":{"type":"string","format":"password","minLength":8},"category_ids":{"type":"array","items":{"$ref":"#/components/schemas/UUID"}},"feed_ids":{"type":"array","items":{"$ref":"#/components/schemas/UUID"}}}},
      "LoginRequest": {"type":"object","required":["email","password"],"properties":{"email":{"type":"string","format":"email"},"password":{"type":"string","format":"password"}}},
      "CategorySelectionRequest": {"type":"object","required":["category_ids"],"properties":{"category_ids":{"type":"array","items":{"$ref":"#/components/schemas/UUID"}}}},
      "CreateFeedRequest": {"type":"object","required":["url","category_ids"],"properties":{"url":{"type":"string","format":"uri"},"category_ids":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/UUID"}}}},
      "Profile": {"type":"object","properties":{"user":{"$ref":"#/components/schemas/User"},"categories":{"type":"array","items":{"$ref":"#/components/schemas/Category"}},"feeds":{"type":"array","items":{"$ref":"#/components/schemas/Feed"}}}}
    },
    "responses": {
      "BadRequest": {"description":"Invalid request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},
      "Unauthorized": {"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}
    }
  },
  "paths": {
    "/v1/health": {"get":{"tags":["Health"],"summary":"Readiness check","responses":{"200":{"description":"Ready"}}}},
    "/v1/err": {"get":{"tags":["Health"],"summary":"Intentional error response","responses":{"500":{"description":"Error"}}}},
    "/v1/auth/register": {"post":{"tags":["Authentication"],"summary":"Register and start a session","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterRequest"},"example":{"name":"Ada Lovelace","email":"ada@example.com","password":"password123","category_ids":[],"feed_ids":[]}}}},"responses":{"201":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/User"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"409":{"description":"Email already exists"}}}},
    "/v1/auth/login": {"post":{"tags":["Authentication"],"summary":"Login and start a session","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"},"example":{"email":"ada@example.com","password":"password123"}}}},"responses":{"200":{"description":"Authenticated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/User"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/v1/auth/logout": {"post":{"tags":["Authentication"],"summary":"End the current session","security":[{"sessionCookie":[]}],"responses":{"204":{"description":"Logged out"}}}},
    "/v1/categories": {"get":{"tags":["Discovery"],"summary":"List seeded categories","responses":{"200":{"description":"Categories","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Category"}}}}}}}},
    "/v1/feeds": {
      "get":{"tags":["Discovery"],"summary":"Discover feeds","parameters":[{"name":"category_ids","in":"query","description":"Comma-separated category UUIDs; matches any selected category.","schema":{"type":"string"}},{"name":"q","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"Feeds","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Feed"}}}}},"400":{"$ref":"#/components/responses/BadRequest"}}},
      "post":{"tags":["Discovery"],"summary":"Contribute an RSS or Atom feed","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateFeedRequest"}}}},"responses":{"200":{"description":"Existing feed followed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Feed"}}}},"201":{"description":"Created and followed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Feed"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"}}}
    },
    "/v1/feeds/{feedID}": {"get":{"tags":["Discovery"],"summary":"Get a feed by ID","parameters":[{"name":"feedID","in":"path","required":true,"schema":{"$ref":"#/components/schemas/UUID"}}],"responses":{"200":{"description":"Feed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Feed"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"404":{"description":"Not found"}}}},
    "/v1/me": {"get":{"tags":["Profile"],"summary":"Get authenticated profile","security":[{"sessionCookie":[]}],"responses":{"200":{"description":"Profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Profile"}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/v1/me/categories": {"put":{"tags":["Profile"],"summary":"Replace interests","security":[{"sessionCookie":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CategorySelectionRequest"}}}},"responses":{"200":{"description":"Selected categories","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Category"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/v1/me/feeds": {"get":{"tags":["Profile"],"summary":"List followed feeds","security":[{"sessionCookie":[]}],"responses":{"200":{"description":"Followed feeds","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Feed"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/v1/me/feeds/{feedID}": {
      "post":{"tags":["Profile"],"summary":"Follow a feed","security":[{"sessionCookie":[]}],"parameters":[{"name":"feedID","in":"path","required":true,"schema":{"$ref":"#/components/schemas/UUID"}}],"responses":{"200":{"description":"Followed feed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Feed"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"description":"Not found"}}},
      "delete":{"tags":["Profile"],"summary":"Unfollow a feed","security":[{"sessionCookie":[]}],"parameters":[{"name":"feedID","in":"path","required":true,"schema":{"$ref":"#/components/schemas/UUID"}}],"responses":{"204":{"description":"Unfollowed"},"401":{"$ref":"#/components/responses/Unauthorized"}}}
    },
    "/v1/posts": {"get":{"tags":["Posts"],"summary":"Get personalized newest-first posts","security":[{"sessionCookie":[]}],"parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"Posts","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Post"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"}}}}
  }
}
