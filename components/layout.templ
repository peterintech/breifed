package components

import webtypes "github.com/peterintech/briefed/types"

templ Header(viewer *webtypes.Viewer) {
	<header class="border-b border-rule bg-paper">
		<div class="mx-auto flex max-w-[96rem] items-center gap-5 px-5 py-5 lg:px-8">
			<a href="/"><img src="public/logo.png" alt="Briefed" width="160px" height="50px"/></a>
			<div class="ml-auto flex items-center gap-3">
				if viewer == nil {
					<a href="/login" class="rounded-control px-4 py-2 text-sm font-semibold text-ink transition-colors hover:bg-paper-raised">
						Log in
					</a>
					<button type="button" data-action="open-onboarding" class="rounded-full bg-forest-900 px-5 py-2.5 text-sm font-semibold text-paper-raised transition-colors hover:bg-forest-800">
						Personalize
					</button>
				} else {
					<span class="hidden text-sm text-muted sm:inline">Hi, { viewer.Name }</span>
					<button
						type="button"
						data-drawer-trigger
						hx-get="/partials/preferences"
						hx-target="#overlay-root"
						hx-swap="innerHTML"
						class="rounded-full bg-forest-900 px-5 py-2.5 text-sm font-semibold text-paper-raised transition-colors hover:bg-forest-800"
					>
						<span class="sm:hidden">Tune</span><span class="hidden sm:inline">Personalize</span>
					</button>
					<form method="post" action="/auth/logout" hx-post="/auth/logout" hx-swap="none">
						<button type="submit" class="rounded-control px-3 py-2 text-sm font-semibold text-muted transition-colors hover:text-ink">
							<span class="hidden md:inline">Log out</span><span class="md:hidden">Out</span>
						</button>
					</form>
				}
			</div>
		</div>
	</header>
}
