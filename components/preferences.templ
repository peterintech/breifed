package components

import (
	"fmt"
	webtypes "github.com/peterintech/briefed/types"
)

templ PreferencesDrawer(data webtypes.PreferencesData) {
	<div id="preferences-overlay" data-drawer-overlay class="fixed inset-0 z-50">
		<button type="button" data-action="close-drawer" aria-label="Close preferences" class="drawer-backdrop absolute inset-0 bg-ink/35" data-open="false"></button>
		<aside class="drawer-panel absolute inset-y-0 right-0 flex w-full max-w-[27.5rem] flex-col border-l border-rule bg-paper-raised shadow-overlay" data-open="false" aria-labelledby="preferences-title">
			<header class="flex items-start justify-between gap-5 border-b border-rule px-6 py-6">
				<div><p class="text-xs font-bold uppercase tracking-[0.1em] text-forest-800">Preferences</p><h2 id="preferences-title" class="mt-2 text-3xl font-bold tracking-[-0.04em] text-ink">Shape your Briefed</h2><p class="mt-2 text-sm leading-6 text-muted">Tune the topics and sources behind your personal feed.</p></div>
				<button type="button" data-action="close-drawer" data-drawer-focus aria-label="Close" class="grid size-10 shrink-0 place-items-center rounded-full text-muted hover:bg-paper hover:text-ink"><span aria-hidden="true" class="text-2xl">×</span></button>
			</header>
			<form id="preferences-form" hx-put="/partials/preferences" hx-target="#preferences-error" hx-swap="innerHTML" class="flex min-h-0 flex-1 flex-col">
				<div class="min-h-0 flex-1 overflow-y-auto px-6 py-6">
					<div id="preferences-error">
						if data.Error != "" {
							@InlineError(data.Error)
						}
					</div>
					<fieldset>
						<legend class="text-xs font-bold uppercase tracking-[0.09em] text-ink">Selected interests</legend>
						<p class="mt-2 text-sm leading-6 text-muted">Sources below update as your interests change.</p>
						<div class="mt-4 flex flex-wrap gap-2">
							for _, category := range data.Categories {
								<label><input class="peer sr-only" type="checkbox" name="category_ids" value={ category.ID.String() } checked?={ selected(data.SelectedCategoryIDs, category.ID) } hx-get="/partials/preferences/feeds" hx-trigger="change" hx-include="#preferences-form" hx-target="#preference-feeds" hx-swap="outerHTML"/><span class="inline-flex cursor-pointer rounded-full border border-rule px-4 py-2 text-sm font-semibold text-ink hover:border-forest-700 peer-checked:border-forest-800 peer-checked:bg-forest-50 peer-checked:text-forest-900 peer-focus-visible:ring-2 peer-focus-visible:ring-forest-800">{ category.Name }</span></label>
							}
						</div>
					</fieldset>
					<div class="mt-8 border-t border-rule pt-7">
						<div class="flex items-end justify-between gap-4"><div><h3 class="text-xs font-bold uppercase tracking-[0.09em] text-ink">Followed sources</h3><p class="mt-2 text-sm leading-6 text-muted">Choose which publishers should appear in your timeline.</p></div><span class="text-xs text-muted">{ fmt.Sprint(selectedFeedCount(data.Feeds)) } selected</span></div>
						@PreferenceFeeds(data.Feeds)
					</div>
				</div>
				<footer class="flex items-center justify-end gap-3 border-t border-rule px-6 py-5"><button type="button" data-action="close-drawer" class="rounded-control px-5 py-3 text-sm font-semibold text-muted hover:text-ink">Cancel</button><button type="submit" class="rounded-full bg-forest-900 px-6 py-3 text-sm font-semibold text-paper-raised hover:bg-forest-800">Save changes</button></footer>
			</form>
		</aside>
	</div>
}

templ PreferenceFeeds(feeds []webtypes.FeedOption) {
	<div id="preference-feeds" class="mt-4 space-y-2">
		if len(feeds) == 0 {
			<p class="rounded-control border border-dashed border-rule px-4 py-6 text-center text-sm text-muted">Choose an interest to see matching sources.</p>
		} else {
			for _, feed := range feeds {
				<label class="block"><input class="peer sr-only" type="checkbox" name="feed_ids" value={ feed.ID.String() } checked?={ feed.Selected }/><span class="flex cursor-pointer items-center gap-3 rounded-control border border-transparent px-3 py-3 hover:bg-paper peer-checked:border-forest-800 peer-checked:bg-forest-50 peer-focus-visible:ring-2 peer-focus-visible:ring-forest-800"><span class="grid size-10 shrink-0 place-items-center rounded-full bg-ink text-[0.65rem] font-bold text-paper">{ initials(feed.Name) }</span><span class="min-w-0 flex-1 truncate text-sm font-semibold text-ink">{ feed.Name }</span><span class="text-xs font-semibold text-forest-800 peer-checked:inline">Follow</span></span></label>
			}
		}
	</div>
}
